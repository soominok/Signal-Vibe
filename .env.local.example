# ───────────────────────────────────────────────
# 재테크 레이더 — 환경 변수 템플릿
# 이 파일을 복사해 .env.local로 이름 바꾸고 값을 채우세요.
# .env.local은 git에 커밋되지 않습니다.
# ───────────────────────────────────────────────

# [필수] Supabase — DB / 인증
# 발급: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ────── 데이터 연결 (없으면 mock 데이터 사용) ──────

# [권장] Anthropic API — 뉴스 감성 분석, Insight LLM 생성
# 발급: https://console.anthropic.com/ → API Keys
# 비용: claude-haiku 기준 약 $0.00025/1K tokens (매우 저렴)
ANTHROPIC_API_KEY=sk-ant-...

# [권장] Alpha Vantage — 해외 주가·지수 실데이터
# 발급: https://www.alphavantage.co/support/#api-key (무료, 즉시 발급)
# 한도: 무료 500 calls/day, 5 calls/min
ALPHA_VANTAGE_API_KEY=

# [권장] 한국은행 ECOS — 기준금리·CPI·GDP 등 거시경제 지표
# 발급: https://ecos.bok.or.kr/ → 인증키 신청 (무료, 즉시)
ECOS_API_KEY=

# [선택] 뉴스 API — 키워드 뉴스 수집
# 발급: https://newsapi.org/ (무료 100 calls/day)
# 대안: 뉴스1·머니투데이 RSS 파싱 (무료, 구현 필요)
NEWS_API_KEY=

# [선택] 한국투자증권 KIS Developers — 국내 주가·수급 실데이터
# 발급: https://apiportal.koreainvestment.com/ (KIS 계좌 필요)
# 참고: 모의투자 앱키로 일부 조회 가능 (실시간 제한)
KIS_APP_KEY=
KIS_APP_SECRET=
