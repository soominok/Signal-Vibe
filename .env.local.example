# ───────────────────────────────────────────────
# 재테크 레이더 — 환경 변수 템플릿
# .env.local로 복사 후 값 채우기 (.env.local은 git 제외)
# ───────────────────────────────────────────────

# [필수] Supabase — DB / 인증
# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── AI ──────────────────────────────────────────
# [연결됨] Anthropic — 뉴스 감성 분석, Insight LLM 생성
# https://console.anthropic.com/ → API Keys
# 비용: claude-haiku 기준 $0.00025/1K tokens
ANTHROPIC_API_KEY=sk-ant-...

# ── 국내 거시경제 ────────────────────────────────
# [연결됨] 한국은행 ECOS — 기준금리·CPI·원달러 환율
# https://ecos.bok.or.kr/ → 인증키 신청 (무료, 즉시)
ECOS_API_KEY=

# ── 국내 주식 ────────────────────────────────────
# [연결됨] 키움증권 REST API — 국내 시세·수급·거래대금 순위
# https://developers.kiwoom.com/ → 앱 등록 후 발급
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# ── 해외 주식 ────────────────────────────────────
# Twelve Data (권장) — 해외 지수·종목 실시간, 800 calls/day 무료
# https://twelvedata.com/ → Get API Key (즉시)
TWELVE_DATA_API_KEY=

# Alpha Vantage (대안) — 500 calls/day 무료, 속도 느림
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── 뉴스 ─────────────────────────────────────────
# 네이버 뉴스 검색 API (권장) — 25,000 건/day 무료, 한국어 최적화
# https://developers.naver.com/apps/ → 앱 등록 → 검색 API 추가
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# NewsAPI (글로벌 뉴스 보완) — 100 calls/day 무료
# https://newsapi.org/
NEWS_API_KEY=
